{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zzalcam",
  "version": "0.1.0",
  "identifier": "dev.zzalcam.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "zzalcam",
        "width": 560,
        "height": 640,
        "resizable": true,
        "visible": false,
        "center": true,
        "create": false
      },
      {
        "label": "controlbar",
        "title": "zzalcam",
        "width": 360,
        "height": 48,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "shadow": false,
        "create": false,
        "focusable": false
      },
      {
        "label": "toast",
        "title": "zzalcam",
        "width": 360,
        "height": 96,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "shadow": false,
        "create": false,
        "focusable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
